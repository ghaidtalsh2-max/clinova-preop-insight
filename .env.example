# ==========================================
# Clinova — Environment Variables Template
# ==========================================

# Application Metadata
VITE_APP_NAME="Clinova"
VITE_APP_TAGLINE="Soft Clinical Intelligence"
VITE_APP_VERSION="1.0.0"

# AI Reasoning & Transcription API Keys (OpenRouter & Speechmatics)
VITE_OPENROUTER_API_KEY="sk-or-v1-..."
VITE_OPENROUTER_MODEL="openai/gpt-4o-mini"
VITE_SPEECHMATICS_API_KEY="..."

# Optional AI API Configurations (if integrating external LLM endpoints)
VITE_OPENAI_API_KEY=""
VITE_GEMINI_API_KEY=""
VITE_AI_API_BASE_URL=""

# Clinical Integration & Standards Endpoints
VITE_NPHIES_SANDBOX_URL="https://nphies.sa/sandbox"
VITE_FDA_API_BASE_URL="https://api.fda.gov"
VITE_MOH_PROTOCOLS_URL="https://www.moh.gov.sa/en/ministry/mediacenter/publications/pages/protocols.aspx"
VITE_PHA_RISK_URL="https://www.pha.gov.sa/ar-sa/Healthportal/Pages/RiskFactor.aspx"
